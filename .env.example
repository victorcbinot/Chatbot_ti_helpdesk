# Copie este arquivo para .env e preencha com sua chave real.
# Como obter a OLLAMA_API_KEY:
#   1. Crie uma conta em https://ollama.com
#   2. Gere uma chave em https://ollama.com/settings/keys
#   3. Cole o valor abaixo (a chave só é exibida uma vez ao ser criada)

OLLAMA_API_KEY=sua_chave_aqui

# Base URL da API da Ollama Cloud (não precisa alterar).
OLLAMA_BASE_URL=https://ollama.com